# Copy to .env; never commit real keys. Restart the application after changes.
# Local development: Anthropic through its OpenAI-compatible interface.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
OPENAI_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_DEFAULT_REGION=us-west-2

# Production (CD writes these into the remote .env):
# LLM_PROVIDER=bedrock_openai
# LLM_MODEL=openai.gpt-5.6-luna
# OPENAI_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/openai/v1
# OPENAI_API_KEY=<Bedrock API key>
# Bedrock only: when OPENAI_API_KEY is empty, ANTHROPIC_API_KEY is a legacy fallback.
# A Bedrock key is NOT an Anthropic Claude API key.

WATCHDOG_DB=data/watchdog.sqlite
X_DEMO_TOKEN=
GOOGLE_MAPS_API_KEY=
