# Copy to .env. Everything works without ANTHROPIC_API_KEY except the Q&A drawer (shows "未設定").
ANTHROPIC_API_KEY=
WATCHDOG_DB=data/watchdog.sqlite
X_DEMO_TOKEN=
GOOGLE_MAPS_API_KEY=   # optional: Google Places 評價（園所詳情／排名「評價」欄）
OPENAI_API_KEY=       # optional: 問答改用 OpenAI（預設 gpt-5，可用 WATCHDOG_OPENAI_MODEL 改）
GEMINI_API_KEY=       # optional: 問答改用 Gemini（預設 gemini-2.5-flash，WATCHDOG_GEMINI_MODEL 改）
WATCHDOG_AGENT_PROVIDER=   # anthropic | openai | gemini（預設取第一個有金鑰的）
